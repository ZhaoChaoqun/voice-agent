# Copy to .env and replace placeholders. Never commit the populated file.
# Local offline/manual controls work with these Foundry fields left unset.
FOUNDRY_PROJECT_ENDPOINT=
SMART_HOME_FLASH_AGENT=REPLACE_WITH_FLASH_AGENT_NAME
SMART_HOME_REALTIME_AGENT=REPLACE_WITH_REALTIME_AGENT_NAME
# Optional GPT Live (gpt-live-1) Agent; no default name.
SMART_HOME_GPT_LIVE_AGENT=
# Optional project for the GPT Live Agent; defaults to FOUNDRY_PROJECT_ENDPOINT.
# SMART_HOME_GPT_LIVE_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Publishing only: Responses deployment used when creating a new GPT Live Agent.
# SMART_HOME_GPT_LIVE_DELEGATION_DEPLOYMENT=REPLACE_WITH_RESPONSES_DEPLOYMENT
# Set to microsoft-realtime-flash-1 only after checking your own Flash Agent.
# Add gpt-live-1 only after checking your own GPT Live Agent.
SMART_HOME_VERIFIED_MODELS=
# Optional local Azure CLI tenant or cloud user-assigned managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
HOST=127.0.0.1
PORT=5178
# Optional local household JSON; defaults to .azure/home.json.
# SMART_HOME_LOCAL_STATE_PATH=.azure/home.json
# Optional loopback backend for the edition dev proxies (default http://127.0.0.1:5178).
# Each edition's Vite config reads it from that edition's own environment or
# editions/<name>/.env, not from this sample-root file.
# SMART_HOME_LOCAL_BACKEND=http://127.0.0.1:5178
# Cloud settings are intentionally disabled. HTTPS, persistent storage and
# new random secrets are required; do not expose Vite on a shared network.
SMART_HOME_PUBLIC_ORIGIN=
SMART_HOME_PUBLIC_GUEST_ACCESS=0
SMART_HOME_ACCESS_CODE=
SMART_HOME_SESSION_SECRET=
SMART_HOME_DATA_PATH=
# Production UI served by npm start: editions/habitat/dist or editions/modern/dist.
SMART_HOME_WEB_ROOT=editions/habitat/dist
