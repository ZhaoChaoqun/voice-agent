# Copy to .env and replace placeholders. Never commit the populated file.
# Local offline/manual controls work with these Foundry fields left unset.
FOUNDRY_PROJECT_ENDPOINT=
HAIER_REALTIME_AGENT=REPLACE_WITH_REALTIME_AGENT_NAME
HAIER_MINI_AGENT=REPLACE_WITH_MINI_AGENT_NAME
HAIER_SECONDARY_MODEL_ID=gpt-realtime-2.1-mini
# Set only after checking the exact Agents/models in your own project.
HAIER_VERIFIED_MODELS=
# Optional local Azure CLI tenant or cloud user-assigned managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
HOST=127.0.0.1
PORT=5178
# Cloud settings are intentionally disabled. HTTPS, persistent storage and
# new random secrets are required; do not expose Vite on a shared network.
HAIER_PUBLIC_ORIGIN=
HAIER_PUBLIC_GUEST_ACCESS=0
HAIER_ACCESS_CODE=
HAIER_SESSION_SECRET=
HAIER_DATA_PATH=
HAIER_WEB_ROOT=dist
# Optional loopback-only WebRTC model-mode lab; not a Voice Agent endpoint.
VOICE_LIVE_ENDPOINT=
WEBRTC_MODEL=gpt-realtime-2.1
